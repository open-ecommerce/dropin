# ─────────────────────────────────────────────
# Copiá este archivo a .env y completá los valores
# cp .env.example .env
# ─────────────────────────────────────────────

# Yii2 environment
YII_DEBUG=1
YII_ENV=dev
YII_TRACE_LEVEL=0

# App
APP_NAME="Drop-in"
APP_SUPPORT_EMAIL=support@example.com
APP_ADMIN_EMAIL=admin@example.com
APP_COOKIE_VALIDATION_KEY=cambia-esto-por-una-clave-aleatoria-larga
APP_PRETTY_URLS=1
APP_ADMIN_PASSWORD=admin123

# Database — con Docker local usar host=db (nombre del servicio)
DATABASE_DSN=mysql:host=db;dbname=dropin
DATABASE_USER=dropin
DATABASE_PASSWORD=dropin123
DATABASE_TABLE_PREFIX=
