{
    "name": "phundament/app",
    "description": "12factor Application Template for Yii 2.0 Framework",
    "keywords": [
        "phundament",
        "yii2",
        "app",
        "framework",
        "application",
        "template",
        "boilerplate",
        "docker",
        "12factor",
        "dotenv"
    ],
    "homepage": "http://www.phundament.com/",
    "type": "project",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Tobias Munk",
            "email": "schmunk@usrbin.de",
            "homepage": "http://www.phundament.com"
        }
    ],
    "support": {
        "issues": "https://github.com/phundament/app/issues?state=open",
        "source": "https://github.com/phundament/app"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1",
        "2amigos/yii2-usuario": "^1.4",
        "dmstr/yii2-adminlte-asset": "2.*",
        "dmstr/yii2-app-command": "@stable",
        "dmstr/yii2-log": "@stable",
        "dmstr/yii2-migrate-command": "@stable",
        "mikehaertl/php-shellcommand": "1.*",
        "vlucas/phpdotenv": "^5.6",
        "yiisoft/yii2": "^2.0.50",
        "kartik-v/yii2-dynagrid": "*",
        "yiisoft/yii2-bootstrap": "2.*",
        "yiisoft/yii2-composer": "*",
        "yiisoft/yii2-symfonymailer": "^2.0",
        "kartik-v/yii2-grid": "*",
        "kartik-v/yii2-widget-select2": "*",
        "kartik-v/yii2-mpdf": "*",
        "kartik-v/yii2-helpers": "*",
        "kartik-v/yii2-widgets": "*",
        "kartik-v/yii2-datecontrol": "*",
        "kartik-v/yii2-export": "*",
        "npm-asset/admin-lte": "^2.4"
    },
    "require-dev": {
        "yiisoft/yii2-debug": "^2.1",
        "yiisoft/yii2-gii": "^2.2",
        "schmunk42/yii2-giiant": "*"
    },
    "scripts": {
        "post-create-project-cmd": [
            "yii\\composer\\Installer::postCreateProject"
        ]
    },
    "extra": {
        "yii\\composer\\Installer::postCreateProject": {
            "setPermission": [
                {
                    "runtime": "0777",
                    "web/assets": "0777",
                    "yii": "0755"
                }
            ]
        },
        "asset-installer-paths": {
            "npm-asset-library": "vendor/npm-asset",
            "bower-asset-library": "vendor/bower-asset"
        }
    },
    "config": {
        "process-timeout": 1800,
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "fxp/composer-asset-plugin": true
        }
    }
}
